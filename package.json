{
    "name": "pokemon-builder",
    "description": "A data-driven Pokémon team builder built with vanilla JavaScript, Vite, and Pico CSS.",
    "author": "Jennifer Tesolin",
    "private": true,
    "version": "0.6.0",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "https://github.com/jennifert/pokemon-builder-public"
    },
    "browserslist": [
        "last 2 Chrome versions",
        "last 2 Firefox versions",
        "last 2 Safari versions",
        "last 2 Edge versions"
    ],
    "scripts": {
        "docs": "jsdoc -c jsdoc.json",
        "info:browserslist": "npx browserslist",
        "lint:js": "eslint \"src/**/*.js\"",
        "lint:jsFix": "eslint \"src/**/*.js\" --fix",
        "lint:css": "stylelint src/css/style.css",
        "lint": "npm run lint:js && npm run lint:css",
        "a11y:dev": "npx axe http://localhost:5173",
        "a11y:prod": "npx axe https://team-builder-app-7tqzs.ondigitalocean.app/",
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview"
    },
    "devDependencies": {
        "@axe-core/cli": "^4.10.2",
        "@eslint/js": "^9.28.0",
        "eslint": "^9.28.0",
        "globals": "^16.2.0",
        "jsdoc": "^4.0.4",
        "stylelint": "^16.20.0",
        "stylelint-config-standard": "^38.0.0",
        "vite": "^6.3.5"
    }
}